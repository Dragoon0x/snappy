{
  "name": "snappy",
  "version": "0.1.0",
  "description": "A 100% client-side screenshot beautifier. Open source, no signup, local storage only.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "screens": "playwright test --config=scripts/capture-screens.config.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "dexie": "^4.0.10",
    "immer": "^10.1.1",
    "konva": "^9.3.18",
    "lucide-react": "^0.460.0",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5",
    "three": "^0.169.0",
    "zundo": "^2.2.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4"
  }
}
